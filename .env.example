CI_ENVIRONMENT = production

app.baseURL = 'https://emcc.example.go.th/'

# IP ของ reverse proxy / load balancer ที่ทำ HTTPS ให้ (คั่นด้วย , รองรับ CIDR) — อยู่หลัง proxy ต้องตั้ง
# ไม่ตั้ง = redirect http -> https วนไม่จบ และผู้ใช้ทุกคนมี IP เดียวกัน
# TRUSTED_PROXIES = '10.0.0.5'

database.default.hostname = 127.0.0.1
database.default.database = webemcc
database.default.username = emcc
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

emcc.virusScanner = defender

logger.threshold = 4
