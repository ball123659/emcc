#--------------------------------------------------------------------
# EMCC — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
#--------------------------------------------------------------------

# development | production
CI_ENVIRONMENT = production

app.baseURL = 'https://emcc.example.go.th/'

# IP ของ reverse proxy / load balancer ที่เชื่อถือ คั่นด้วย , (รองรับ CIDR) — จำเป็นถ้าเว็บอยู่หลัง proxy ที่ทำ HTTPS ให้
# ไม่ตั้ง = ผู้ใช้ทุกคนจะมี IP เดียวกัน (จำกัดการล็อกอิน/ดาวน์โหลดรวมกันทั้งองค์กร, ยอดดาวน์โหลดเพี้ยน, log IP ผิด)
# TRUSTED_PROXIES = '10.0.0.5,10.0.1.0/24'

#--------------------------------------------------------------------
# ฐานข้อมูล MySQL 8 / MariaDB 10.4+ (utf8mb4_general_ci)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = webemcc
database.default.username = emcc
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# กุญแจเข้ารหัส — สร้างด้วย: php spark key:generate
#--------------------------------------------------------------------
# encryption.key =

#--------------------------------------------------------------------
# EMCC
#--------------------------------------------------------------------
# สแกนไวรัส: none (เครื่อง dev เท่านั้น — โปรดักชันจะไม่รับไฟล์) | defender (Windows) | clamav (Linux)
emcc.virusScanner = defender
# emcc.defenderBinary = 'C:\Program Files\Windows Defender\MpCmdRun.exe'
# emcc.clamavBinary = clamdscan

# redirect http -> https (ปิดได้ถ้า IIS/proxy redirect ให้แล้ว)
# emcc.forceHttps = true

# เก็บบันทึกการใช้งานกี่วัน
# emcc.activityLogRetentionDays = 730

# บันทึก log ระดับใด (production ควรเป็น 4 = warning ขึ้นไป)
logger.threshold = 4
