{
    "name": "emcc/backend",
    "description": "EMCC — เว็บไซต์และระบบหลังบ้าน (CodeIgniter 4)",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.7",
        "symfony/html-sanitizer": "^7.4",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support", "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
