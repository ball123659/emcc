# EMCC (CodeIgniter 4)
.env
.env.backup
.env.production
/vendor/
/build/
.phpunit.result.cache

# writable: เก็บเฉพาะโครงโฟลเดอร์ (index.html) ไม่เก็บไฟล์ที่ระบบสร้าง
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/storage/
/writable/.phpunit.cache/

.DS_Store
Thumbs.db
/.idea
/.vscode
/node_modules
